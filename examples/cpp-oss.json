{
  "schema_version": 1,
  "targets": [
    {
      "id": "oss-cpp-s3",
      "provider": "oss",
      "language": "cpp",
      "api": "s3",
      "sdk": "aws-sdk-cpp",
      "sdk_version": "1.11.675",
      "command": [
        "drivers/cpp/build/osv-cpp-s3"
      ],
      "env": {
        "OSV_ENDPOINT": "https://replace-oss-s3-endpoint",
        "OSV_REGION": "replace-region",
        "OSV_BUCKET": "replace-with-test-bucket",
        "OSV_PATH_STYLE": "false",
        "OSV_RETRIES": "0",
        "OSV_CONNECTIONS": "16"
      }
    },
    {
      "id": "oss-cpp-native",
      "provider": "oss",
      "language": "cpp",
      "api": "native",
      "sdk": "aliyun-oss-cpp-sdk",
      "sdk_version": "1.10.1",
      "command": [
        "drivers/cpp/build/osv-cpp-oss"
      ],
      "env": {
        "OSV_ENDPOINT": "https://replace-oss-native-endpoint",
        "OSV_REGION": "replace-region",
        "OSV_BUCKET": "replace-with-test-bucket",
        "OSV_RETRIES": "0",
        "OSV_CONNECTIONS": "16"
      }
    }
  ],
  "workload": {
    "object_size": 8388608,
    "range_size": 65536,
    "part_size": 8388608,
    "requests": 100,
    "concurrency": 4,
    "rounds": 3,
    "warmup_requests": 4,
    "operations": [
      "get",
      "range",
      "put",
      "head",
      "list"
    ],
    "seed": 1729
  },
  "comparisons": [
    {
      "s3": "oss-cpp-s3",
      "native": "oss-cpp-native",
      "same_storage_and_network_confirmed": false,
      "min_samples": 100,
      "min_throughput_ratio": 0.9,
      "max_p95_ratio": 1.1
    }
  ]
}
