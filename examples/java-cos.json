{
  "schema_version": 1,
  "targets": [
    {
      "id": "cos-java-s3",
      "provider": "cos",
      "language": "java",
      "api": "s3",
      "sdk": "aws-sdk-java-v2",
      "sdk_version": "2.20.162",
      "command": [
        "java",
        "-Xmx512m",
        "-jar",
        "drivers/java/target/sdk-worker-0.1.0.jar",
        "s3"
      ],
      "env": {
        "OSV_ENDPOINT": "https://cos.ap-guangzhou.myqcloud.com",
        "OSV_REGION": "ap-guangzhou",
        "OSV_BUCKET": "examplebucket-1250000000",
        "OSV_PATH_STYLE": "false",
        "OSV_RETRIES": "0",
        "OSV_CONNECTIONS": "16"
      }
    },
    {
      "id": "cos-java-native",
      "provider": "cos",
      "language": "java",
      "api": "native",
      "sdk": "cos_api",
      "sdk_version": "5.6.246",
      "command": [
        "java",
        "-Xmx512m",
        "-jar",
        "drivers/java/target/sdk-worker-0.1.0.jar",
        "cos"
      ],
      "env": {
        "OSV_ENDPOINT": "https://examplebucket-1250000000.cos.ap-guangzhou.myqcloud.com",
        "OSV_REGION": "ap-guangzhou",
        "OSV_BUCKET": "examplebucket-1250000000",
        "OSV_RETRIES": "0",
        "OSV_CONNECTIONS": "16"
      }
    }
  ],
  "workload": {
    "object_size": 8388608,
    "range_size": 65536,
    "part_size": 8388608,
    "requests": 100,
    "concurrency": 4,
    "rounds": 3,
    "warmup_requests": 4,
    "operations": [
      "get",
      "range",
      "put",
      "head",
      "list"
    ],
    "seed": 1729
  },
  "comparisons": [
    {
      "s3": "cos-java-s3",
      "native": "cos-java-native",
      "same_storage_and_network_confirmed": false,
      "min_samples": 100,
      "min_throughput_ratio": 0.9,
      "max_p95_ratio": 1.1
    }
  ]
}
